{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "herdr-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "vars": {
    "RELAY_ORIGIN": "https://herdr-relay.hackerchai.com",
    "ADMISSION_ENABLED": "true",
    "METADATA_RETENTION_HOURS": "25",
    "GLOBAL_REQUESTS_PER_MINUTE": "600",
    "GLOBAL_REQUESTS_PER_DAY": "100000",
    "GLOBAL_IP_REQUESTS_PER_MINUTE": "240",
    "GLOBAL_PENDING_REQUESTS": "32",
    "GLOBAL_CHALLENGES": "256",
    "GLOBAL_PUBLISHERS": "64",
    "GLOBAL_CHANNELS": "32",
    "GLOBAL_PENDING_CHANNELS": "64",
    "GLOBAL_CHANNEL_SECONDS_PER_DAY": "345600",
    "CHANNEL_BYTES_PER_SECOND": "1048576",
    "CHANNEL_WINDOW_BYTES": "262144",
    "MONTHLY_BUDGET": "on",
    "OPERATOR_DEVICE_IDS": "2884693590c6dd699802aa628ff5440de79ec1b49189f6b7bbf3c8a45dfd55b7",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH",
        "class_name": "AccessGate",
      },
      {
        "name": "DEVICES",
        "class_name": "DeviceRelay",
      },
      {
        "name": "ROOMS",
        "class_name": "Room",
      },
      {
        "name": "ADMISSION",
        "class_name": "Admission",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AccessGate", "DeviceRelay"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Room"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["Admission"],
    },
  ],
  "observability": {
    "enabled": false,
  },
  "preview_urls": false,
  "routes": [
    {
      "pattern": "herdr-relay.hackerchai.com",
      "custom_domain": true,
    },
  ],
}
